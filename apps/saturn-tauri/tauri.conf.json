{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Easy Edits Pro",
  "version": "0.1.0",
  "identifier": "com.zvirox.easyeditspro",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "beforeBundleCommand": "bash ../../scripts/prepare-bundle-inputs.sh",
    "frontendDist": "ui/dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; media-src 'self' asset: http://asset.localhost http://127.0.0.1:* blob: data:; img-src 'self' asset: http://asset.localhost http://127.0.0.1:* https: blob: data:; style-src 'self'; font-src 'self' data:;",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    },
    "windows": [
      {
        "title": "Easy Edits Pro",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm"],
    "category": "Video",
    "license": "AGPL-3.0-or-later",
    "licenseFile": "../../LICENSE",
    "shortDescription": "Open source video editor for Linux",
    "longDescription": "Easy Edits Pro is an open source desktop video editor built with Rust, Tauri, and GStreamer.",
    "icon": [
      "../../assets/icons/32x32.png",
      "../../assets/icons/64x64.png",
      "../../assets/icons/128x128.png",
      "../../assets/icons/128x128@2x.png",
      "../../assets/icons/icon.icns",
      "../../assets/icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libgstreamer1.0-0",
          "libgstreamer-plugins-base1.0-0",
          "libges-1.0-0",
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-plugins-ugly",
          "gstreamer1.0-plugins-bad",
          "gstreamer1.0-libav"
        ],
        "files": {
          "/usr/bin/saturn-plugin-worker": "../../target/release/saturn-plugin-worker",
          "/usr/share/doc/easy-edits-pro/copyright": "../../LICENSE",
          "/usr/share/doc/easy-edits-pro/third-party-notices": "../../target/third-party-notices"
        }
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3",
          "gstreamer1",
          "gstreamer1-plugins-base",
          "gstreamer1-plugins-good",
          "gstreamer1-plugins-bad-free",
          "gst-editing-services"
        ],
        "files": {
          "/usr/bin/saturn-plugin-worker": "../../target/release/saturn-plugin-worker",
          "/usr/share/doc/easy-edits-pro/LICENSE": "../../LICENSE",
          "/usr/share/doc/easy-edits-pro/third-party-notices": "../../target/third-party-notices"
        }
      }
    }
  }
}
