{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://easyeditspro.com/schemas/tasksheet-1.schema.json",
  "title": "TaskSheet",
  "description": "EEP Task Sheet v1 specification for agent-operated post-production work orders",
  "type": "object",
  "required": [
    "schema",
    "id",
    "title",
    "requester",
    "inputs",
    "deliverables",
    "status"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "tasksheet/1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "requester": {
      "type": "string",
      "pattern": "^(human|agent):[a-zA-Z0-9_-]+$"
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "media", "role"],
        "properties": {
          "id": { "type": "string" },
          "media": { "type": "string" },
          "role": {
            "type": "string",
            "enum": ["main_video", "isolated_audio", "music_track", "b_roll", "transcript", "captions", "capture_event_track", "other"]
          },
          "trust": {
            "type": "string",
            "enum": ["trusted", "untrusted"]
          }
        }
      }
    },
    "deliverables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "preset"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "preset": { "type": "string" },
          "duration": {
            "type": "object",
            "required": ["target_s"],
            "properties": {
              "target_s": { "type": "number", "minimum": 0 },
              "tolerance_s": { "type": "number", "minimum": 0 }
            }
          },
          "loudness_lufs": { "type": "number" },
          "true_peak_dbtp": { "type": "number" },
          "captions": { "type": "boolean" },
          "must_include": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "style": {
      "type": "object",
      "properties": {
        "house_style": { "type": "string" },
        "pacing": {
          "type": "string",
          "enum": ["fast", "medium", "slow", "dynamic"]
        },
        "music": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "must_not": {
      "type": "object",
      "properties": {
        "words": { "type": "array", "items": { "type": "string" } },
        "people": { "type": "array", "items": { "type": "string" } },
        "content": { "type": "array", "items": { "type": "string" } }
      }
    },
    "acceptance": {
      "type": "object",
      "properties": {
        "auto": { "type": "array", "items": { "type": "string" } },
        "human": { "type": "array", "items": { "type": "string" } }
      }
    },
    "budget": {
      "type": "object",
      "properties": {
        "wall_clock_min": { "type": "number", "minimum": 0 },
        "model_cost_usd": { "type": "number", "minimum": 0 },
        "render_min": { "type": "number", "minimum": 0 }
      }
    },
    "escalate_when": {
      "type": "array",
      "items": { "type": "string" }
    },
    "handoff": {
      "type": "object",
      "properties": {
        "exports": { "type": "boolean" },
        "project_file": { "type": "boolean" },
        "interchange": {
          "type": "array",
          "items": { "type": "string", "enum": ["fcpxml", "xmeml", "edl", "otio"] }
        },
        "qc_report": { "type": "boolean" },
        "change_log": { "type": "boolean" }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "ready",
        "planning",
        "awaiting_plan_approval",
        "running",
        "needs_input",
        "in_review",
        "revision_requested",
        "approved",
        "delivered",
        "failed",
        "cancelled",
        "stopped"
      ]
    },
    "plan": {
      "type": "object",
      "properties": {
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "title", "status"],
            "properties": {
              "id": { "type": "integer" },
              "title": { "type": "string" },
              "description": { "type": "string" },
              "status": { "type": "string", "enum": ["pending", "current", "done", "skipped"] },
              "target_tick": { "type": "integer" }
            }
          }
        },
        "submitted_by": { "type": "string" },
        "submitted_at_unix_ms": { "type": "integer" },
        "approved_by": { "type": "string" },
        "approved_at_unix_ms": { "type": "integer" },
        "rejection_reason": { "type": "string" }
      }
    },
    "rounds": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["round_number", "started_at_unix_ms"],
        "properties": {
          "round_number": { "type": "integer", "minimum": 1 },
          "label": { "type": "string" },
          "started_at_unix_ms": { "type": "integer" },
          "completed_at_unix_ms": { "type": "integer" },
          "opened_by": { "type": "string" },
          "closed_by": { "type": "string" },
          "outcome": { "type": "string", "enum": ["revision_requested", "approved"] },
          "snapshot_at_open": { "type": "object" },
          "snapshot_at_close": { "type": "object" },
          "diff_from_prior": { "type": "object" },
          "notes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "author", "created_at_unix_ms", "text", "status"],
              "properties": {
                "id": { "type": "string" },
                "author": { "type": "string" },
                "created_at_unix_ms": { "type": "integer" },
                "text": { "type": "string" },
                "target_tick": { "type": "integer" },
                "end_tick": { "type": "integer" },
                "clip_id": { "type": "integer" },
                "track_id": { "type": "integer" },
                "status": { "type": "string", "enum": ["open", "resolved", "dismissed"] },
                "resolution": { "type": "string" },
                "resolved_by": { "type": "string" },
                "resolved_at_unix_ms": { "type": "integer" }
              }
            }
          }
        }
      }
    },
    "transitions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "actor", "timestamp_unix_ms"],
        "properties": {
          "from": { "type": "string" },
          "to": { "type": "string" },
          "actor": { "type": "string" },
          "timestamp_unix_ms": { "type": "integer" },
          "reason": { "type": "string" }
        }
      }
    }
  }
}
